{
  "name": "bim-diff-benchmark",
  "version": "1.0.1",
  "description": "Local BIM comparison benchmark with browser and OS telemetry",
  "type": "module",
  "bin": {
    "bim-diff": "bin/launch.mjs"
  },
  "files": [
    "bin/",
    "public/",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/NicknameIsAvailable/bim-diff.git"
  },
  "scripts": {
    "start": "node bin/launch.mjs",
    "test": "node --import tsx --test test/*.test.mjs test/*.test.ts packages/bim-diff-core/test/*.test.ts",
    "check-types": "tsc --noEmit",
    "compare": "tsx packages/bim-diff-core/src/cli.ts",
    "build:wasm": "node scripts/build-ifc-wasm.mjs",
    "compare:ifc": "tsx src/cli-ifc-wasm.ts",
    "bench:ifc": "tsx src/cli-ifc-wasm.ts --bench",
    "dev:ui": "vite --config vite.ui.config.ts",
    "build:ui": "vite build --config vite.ui.config.ts",
    "preview:ui": "vite preview --config vite.ui.config.ts"
  },
  "dependencies": {
    "playwright": "1.63.0"
  },
  "devDependencies": {
    "@types/node": "24.6.2",
    "@types/react": "19.1.0",
    "@types/react-dom": "19.1.1",
    "@vitejs/plugin-react": "4.7.0",
    "esbuild": "0.28.2",
    "fflate": "0.8.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tsx": "4.23.12",
    "typescript": "5.9.2",
    "vite": "6.4.3"
  }
}
